<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= article.title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>THE NEW YORK TIMES</h1>
        <nav>
            <a href="/">&larr; Back to All Articles</a>
        </nav>
    </header>

    <main>
        <div class="article-view">
            <h2><%= article.title %></h2>
            <p class="meta-text">By: <%= article.author %> | Published: <%= article.createdAt.toDateString() %></p>
            <hr>
            <div class="article-content"><%= article.article %></div>
            
            <div class="btn-container">
                <a href="/admin/edit/<%= article._id %>" class="btn-edit">Edit Article</a>
                
                <form action="/admin/delete/<%= article._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this article?');">
                    <button type="submit" class="btn-delete">Delete Article</button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
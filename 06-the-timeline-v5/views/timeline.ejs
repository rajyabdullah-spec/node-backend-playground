<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Timeline | Matrix Connect</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="header">
        <div class="header-navigation-wrapper">
            <span>The Timeline</span>
            <div class="nav-auth-links">
                <% if (user) { %>
                    <span class="welcome-msg">Welcome, <strong><%= user.username %></strong></span>
                    <a href="/logout" id="logout-btn" class="nav-link-btn btn-logout-accent">Log Out</a>
                <% } else { %>
                    <a href="/login" class="nav-link-btn">Log In</a>
                    <a href="/signup" class="nav-link-btn btn-signup-accent">Sign Up</a>
                <% } %>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="post-card">
            <% if (user) { %>
                <h3 class="post-title-accent">Post a message</h3>
                
                <% if (locals.error) { %>
                    <div class="error-box">
                        ⚠️ <%= error %>
                    </div>
                <% } %>

                <form action="/add-post" method="POST">
                    <textarea name="post" rows="4" class="main-textarea" placeholder="What's on your mind? (Minimum 25 characters)"></textarea>
                    <button type="submit" class="btn btn-primary">Post a message</button>
                    <div class="clear-fix"></div>
                </form>
            <% } else { %>
                <div class="locked-auth-prompt">
                    <h3>Want to join the conversation?</h3>
                    <p>Only registered members can share messages and comments on the timeline.</p>
                    <div class="prompt-actions">
                        <a href="/login" class="prompt-btn-login">Log In to Post</a>
                        <span class="or-text">or</span>
                        <a href="/signup" class="prompt-btn-signup">Create an Account</a>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="feed-title">Latest Updates</div>

        <% if (posts.length > 0) { %>
            <% posts.forEach(p => { %>
                <div class="post-card">
                    <div class="post-header">
                        <span class="post-author">✍️ Posted by: <strong><%= p.username || 'Anonymous' %></strong></span>
                        <span class="post-date">📅 <%= p.createdAt.toLocaleString() %></span>
                    </div>
                    <p class="post-message"><%= p.post %></p>
                    
                    <div class="post-link-container" style="display: flex; justify-content: space-between; align-items: center;">
                        <% if (user && p.user_id && p.user_id.toString() === user._id.toString()) { %>
                            <span class="post-date" style="background-color: rgba(42, 157, 143, 0.15); color: #2a9d8f; border: 1px solid rgba(42, 157, 143, 0.3); font-weight: 600;">My Post ★</span>
                        <% } else { %>
                            <span></span>
                        <% } %>
                        <a href="/post/<%= p._id %>" class="nav-link-btn" style="font-size: 0.82rem; padding: 4px 10px;">See Details ➡️</a>
                    </div>

                    <div class="comments-section">
                        <h4 class="comments-title">Comments:</h4>
                        
                        <% if (p.comments && p.comments.length > 0) { %>
                            <% p.comments.forEach(c => { %>
                                <div class="comment-card">
                                    
                                    <div id="comment-view-<%= c._id %>">
                                        <p class="comment-text">
                                            <strong class="commenter-name"><%= c.username || 'Guest' %>:</strong> <%= c.comment %>
                                        </p>
                                        <div class="comment-actions">
                                            <small>💬 <%= c.createdAt.toLocaleString() %></small>
                                            
                                            <% if (user && c.user_id && c.user_id.toString() === user._id.toString()) { %>
                                                <button onclick="toggleEditComment('<%= c._id %>')" class="action-link action-edit">✏️ Edit</button>
                                                <button onclick="deleteComment('<%= c._id %>')" class="action-link action-delete">🗑️ Delete</button>
                                            <% } %>
                                        </div>
                                    </div>

                                    <% if (user && c.user_id && c.user_id.toString() === user._id.toString()) { %>
                                        <div id="comment-edit-<%= c._id %>" class="clear-fix" style="display: none;">
                                            <form action="/comment/<%= c._id %>/edit" method="POST">
                                                <input type="text" name="comment" value="<%= c.comment %>" class="comment-input" required>
                                                <button type="submit" class="btn btn-save">Save</button>
                                                <button type="button" onclick="toggleEditComment('<%= c._id %>')" class="btn btn-cancel">Cancel</button>
                                            </form>
                                        </div>
                                    <% } %>

                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="comment-text comment-text-italic">No comments yet.</p>
                        <% } %>

                        <% if (user) { %>
                            <% if (locals.commentError && locals.errorPostId && errorPostId === p._id.toString()) { %>
                                <div class="error-box" style="display: block; width: 100%; margin: 10px 0; clear: both; box-sizing: border-box;">
                                    ⚠️ <%= commentError %>
                                </div>
                            <% } %>
                            <form action="/post/<%= p._id %>/comment" method="POST" class="comment-form-container">
                                <input type="text" name="comment" class="comment-input" placeholder="Write a comment... (Min 10 chars)" required>
                                <button type="submit" class="btn btn-comment">Comment</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <p>No messages posted on the timeline yet.</p>
            </div>
        <% } %>
    </div>

    <script>
        const logoutBtn = document.getElementById('logout-btn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', async (e) => {
                e.preventDefault();
                try {
                    const res = await fetch('/logout', { method: 'GET' });
                    if (res.status === 200) {
                        window.location.assign('/');
                    }
                } catch (err) {
                    console.error('Logout failed:', err);
                }
            });
        }

        function toggleEditComment(id) {
            const viewDiv = document.getElementById(`comment-view-${id}`);
            const editDiv = document.getElementById(`comment-edit-${id}`);
            if (viewDiv && editDiv) {
                if (viewDiv.style.display === 'none') {
                    viewDiv.style.display = 'block';
                    editDiv.style.display = 'none';
                } else {
                    viewDiv.style.display = 'none';
                    editDiv.style.display = 'block';
                }
            }
        }

        async function deleteComment(id) {
            if (confirm('Are you sure you want to delete this comment?')) {
                localStorage.setItem('scrollPosition', window.scrollY);
                const response = await fetch(`/comment/${id}`, { method: 'DELETE' });
                const data = await response.json();
                if (data.redirect) {
                    window.location.href = data.redirect;
                }
            }
        }

        window.addEventListener('beforeunload', () => {
            localStorage.setItem('scrollPosition', window.scrollY);
        });

        window.onload = function() {
            if (window.history.replaceState) {
                const url = new URL(window.location.href);
                url.searchParams.delete('postError');
                url.searchParams.delete('commentError');
                url.searchParams.delete('errorPostId');
                window.history.replaceState(null, null, url.toString());
            }

            const savedScrollPosition = localStorage.getItem('scrollPosition');
            if (savedScrollPosition) {
                window.scrollTo(0, parseInt(savedScrollPosition, 10));
                localStorage.removeItem('scrollPosition');
            }
        };
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Timeline | Matrix Connect</title>
</head>
    <link rel="stylesheet" href="/css/style.css">
<body>

    <div class="header">
        The Timeline
    </div>

    <div class="container">
        <div class="post-card">
            <h3 class="form-title">Post a message</h3>
            
            <% if (error) { %>
                <div class="error-box">
                    ⚠️ <%= error %>
                </div>
            <% } %>

            <form action="/add-post" method="POST">
                <textarea name="post" rows="4" class="form-textarea" placeholder="What's on your mind? (Minimum 25 characters)"></textarea>
                <button type="submit" class="btn-submit">Post a message</button>
                <div class="clearfix"></div>
            </form>
        </div>

        <div class="feed-title">Latest Updates</div>

        <% if (posts.length > 0) { %>
            <% posts.forEach(p => { %>
                <div class="post-card">
                    <div class="post-header">
                        <span class="post-date">📅 <%= p.createdAt.toDateString() %></span>
                    </div>
                    <p class="post-message"><%= p.post %></p>
                    
                    <div class="details-link-container">
                        <a href="/post/<%= p._id %>" class="see-more-link">See More →</a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="empty-state">
                <p>No messages posted on the timeline yet.</p>
            </div>
        <% } %>
    </div>

</body>
</html>